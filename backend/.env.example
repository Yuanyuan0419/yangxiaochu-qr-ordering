# XAMPP MariaDB. On this machine XAMPP listens on 3307 (a separate MySQL 8 owns 3306).
DATABASE_URL="mysql://root:@127.0.0.1:3307/yangxiaochu"
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGINS="http://localhost:5173"
UPLOAD_DIR=""
NODE_ENV=development
# Optional: DeepL API key for one-tap EN/FR translation (free plan: https://www.deepl.com/pro-api). Free keys end in ":fx".
DEEPL_API_KEY=""
